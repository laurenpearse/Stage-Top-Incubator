#    b        BASE heater -> 30 %
#    b0       BASE heater off
#    b35      BASE heater -> any duty up to 60 %
#    off      everything off, loops reset
#    sc 39    set CHAMBER setpoint, degC   (max 50)
#    sg 48    set GLASS setpoint, degC     (max 50)
#    h25      MANUAL heater duty %  (leaves closed loop)
#    g20      MANUAL glass duty %   (leaves closed loop)
#    a21.5    fallback room temperature, only if the BMP280 is missing
#    st       controller internals
#    n text   write a note into the log
#    ?        this help
#
#  COLUMNS
#    T_cham   chamber air, PT1000        T_glass  ITO lid, A3  (control)
#    T_E8     well E8, A2                T_amb    room, BMP280
